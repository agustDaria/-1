import sys
from math_func import calculate_x
from pyramid_func import draw_pyramid


def get_bounded_number(prompt):
    while True:
        try:
            val = float(input(prompt))
            if 1 <= val <= 100:
                return val
            print("Число має бути в межах від 1 до 100.")
        except ValueError:
            print("Введіть коректне число.")


def get_pyramid_n():
    while True:
        try:
            val = int(input("Введіть ціле число N (від 1 до 10): "))
            if 1 <= val <= 10:
                return val
            print("Число має бути від 1 до 10.")
        except ValueError:
            print("Введіть ціле число.")


def main():
    while True:
        print("\nГоловне меню:")
        print("1. Обчислити значення X")
        print("2. Побудувати числову піраміду")
        print("0. Вихід")

        choice = input("Оберіть пункт меню: ").strip()

        if choice == "1":
            print("\nВведіть значення (від 1 до 100):")
            a = get_bounded_number("Введіть a: ")
            b = get_bounded_number("Введіть b: ")
            res = calculate_x(a, b)
            print(f"Результат X = {res}")
        elif choice == "2":
            n = get_pyramid_n()
            print()
            draw_pyramid(n)
        elif choice == "0":
            sys.exit()
        else:
            print("Невірний вибір. Спробуйте ще раз.")


if __name__ == "__main__":
    main()
